{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nostr-signer-bunker",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "nostr-signer.nilpote.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BUNKER",
        "class_name": "BunkerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BunkerDO"]
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
    // 对 / 与 /app/* 直接回源静态资源；API 路径在代码中优先匹配
  },
  "vars": {
    // 默认 relay 列表可在部署时覆盖；键管理 KEK 必须放在 secret：
    // wrangler secret put BUNKER_KEK
    "DEFAULT_RELAYS": "wss://nostr.agh.ccwu.cc,wss://nos.lol,wss://relay.primal.net,wss://relay.damus.io"
  },
  "observability": {
    "enabled": true
  }
}
